{
  "name": "agentic-write",
  "version": "0.1.0",
  "description": "Draft captions, emails, and scripts with Anthropic Claude, OpenAI GPT, or Cloudflare Workers AI through a Node.js SDK, CLI, and MCP.",
  "keywords": [
    "copywriting",
    "captions",
    "email-drafting",
    "script-writing",
    "anthropic",
    "claude",
    "openai",
    "gpt",
    "cloudflare",
    "workers-ai",
    "ai-gateway",
    "nodejs",
    "typescript",
    "cli",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-write.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-write",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-write": "./dist/cli.js",
    "agentic-write-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "agentic-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
